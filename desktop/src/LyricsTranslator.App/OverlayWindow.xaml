<?xml version="1.0" encoding="UTF-8"?>
<Window
    x:Class="LyricsTranslator.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LyricsTranslator.ViewModels"
    Title="移動歌詞">

    <Grid Background="#E612151C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#2A313C">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragBar" Background="Transparent" Padding="12,8">
                <TextBlock Text="移動歌詞 · 拖曳這裡" FontSize="12" Opacity="0.75"/>
            </Grid>
            <Button Grid.Column="1"
                    Content="✕"
                    Padding="10,4"
                    Click="CloseOverlay_Click"
                    ToolTipService.ToolTip="隱藏浮窗（主視窗或系統匣可再開）"/>
        </Grid>

        <ItemsControl Grid.Row="1"
                      Margin="12,8"
                      ItemsSource="{x:Bind ViewModel.OverlayLines, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LyricLineItem">
                    <Border BorderBrush="#2EC4B6"
                            BorderThickness="{x:Bind AccentThickness, Mode=OneWay}"
                            Padding="10,4"
                            Margin="0,2">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Original, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="{x:Bind LineOpacity, Mode=OneWay}"
                                       FontSize="{x:Bind FontSize, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind Translation, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="{x:Bind LineOpacity, Mode=OneWay}"
                                       FontSize="{x:Bind FontSize, Mode=OneWay}"
                                       Foreground="#D7FFF8"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Padding="12,6">
            <TextBlock Text="{x:Bind ViewModel.SyncCaption, Mode=OneWay}" FontSize="11" Opacity="0.55"/>
            <TextBlock Text="{x:Bind ViewModel.PositionLabel, Mode=OneWay}" FontSize="11" Opacity="0.55"/>
        </StackPanel>
    </Grid>
</Window>
